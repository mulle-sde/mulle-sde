#! /bin/sh

[ "${TRACE}" = 'YES' ] && set -x && : "$0" "$@"

###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###
MULLE_BASHFUNCTIONS_LIBEXEC_DIR="`mulle-bashfunctions libexec-dir`" || exit 1
export MULLE_BASHFUNCTIONS_LIBEXEC_DIR
. "${MULLE_BASHFUNCTIONS_LIBEXEC_DIR}/mulle-boot.sh" || exit 1
. "${MULLE_BASHFUNCTIONS_LIBEXEC_DIR}/mulle-bashfunctions.sh" || exit 1
###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###


run_mulle_sde()
{
   log_fluff "####################################" >&2
   log_fluff ${MULLE_SDE} ${MULLE_SDE_FLAGS} "$@"
   log_fluff "####################################" >&2

   (
      MULLE_EXECUTABLE="${MULLE_SDE}"
      MULLE_SDE_LIBEXEC_DIR="`${MULLE_SDE} libexec-dir`"

      . "${MULLE_SDE}" ${MULLE_SDE_FLAGS} "$@"
   )
}


main()
{
   MULLE_SDE_FLAGS="$@"

   _options_mini_main "$@" && set -x

   local directory

   r_make_tmp_directory || exit 1
   directory="${RVAL}"
   directory="${directory:-/tmp/build}"

   run_mulle_sde -s init \
                    -d "${directory}" \
                    -m mulle-sde/c-developer \
                    executable \
   || fail "init failed"

   (
      cd "${directory}" || exit 1

      run_mulle_sde -s reflect || fail "initial reflect failed"
      [ -d "cmake/reflect" ] || fail "initial reflect did not produce cmake/reflect"
      [ -d "src/reflect" ] || fail "initial reflect did not produce src/reflect"

      run_mulle_sde -s config reflect-configs "config" || fail "set reflect-configs failed"
      [ "`run_mulle_sde -s config reflect-configs`" = "config" ] \
      || fail "config reflect-configs did not report config"
      [ ! -d "cmake/reflect" ] || fail "switch to multi did not remove stale cmake/reflect"
      [ ! -d "src/reflect" ] || fail "switch to multi did not remove stale src/reflect"

      run_mulle_sde -s reflect || fail "multi reflect failed"
      [ -d "cmake/reflect.config" ] || fail "multi reflect did not produce cmake/reflect.config"
      [ -d "src/reflect.config" ] || fail "multi reflect did not produce src/reflect.config"

      run_mulle_sde -s config reflect-configs "" || fail "set empty reflect-configs failed"
      [ -z "`run_mulle_sde -s config reflect-configs`" ] \
      || fail "config reflect-configs did not report empty"
      [ ! -d "cmake/reflect.config" ] || fail "switch to legacy did not remove stale cmake/reflect.config"
      [ ! -d "src/reflect.config" ] || fail "switch to legacy did not remove stale src/reflect.config"

      run_mulle_sde -s reflect || fail "legacy reflect failed"
      [ -d "cmake/reflect" ] || fail "legacy reflect did not produce cmake/reflect"
      [ -d "src/reflect" ] || fail "legacy reflect did not produce src/reflect"
    ) || exit 1

   log_info "----- ALL PASSED -----"

   cd ..
   rmdir_safer "${directory}"
}


main "$@"
