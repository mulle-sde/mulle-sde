#! /bin/sh

[ "${TRACE}" = 'YES' ] && set -x && : "$0" "$@"

###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###
MULLE_BASHFUNCTIONS_LIBEXEC_DIR="`mulle-bashfunctions libexec-dir`" || exit 1
export MULLE_BASHFUNCTIONS_LIBEXEC_DIR
. "${MULLE_BASHFUNCTIONS_LIBEXEC_DIR}/mulle-boot.sh" || exit 1
. "${MULLE_BASHFUNCTIONS_LIBEXEC_DIR}/mulle-bashfunctions.sh" || exit 1
###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###


run_mulle_sde()
{
   (
      MULLE_EXECUTABLE="${MULLE_SDE}"
      MULLE_SDE_LIBEXEC_DIR="`${MULLE_SDE} libexec-dir`"

      . "${MULLE_SDE}" ${MULLE_SDE_FLAGS} "$@"
   )
}


expect_line()
{
   local pattern="$1"
   local text="$2"

   if ! printf "%s\n" "${text}" | grep -q "${pattern}"
   then
      fail "Expected pattern \"${pattern}\" not found in output:
${text}"
   fi
}


run_case()
{
   local projecttype="$1"
   local projectdir="$2"
   local output

   run_mulle_sde -s init \
                    -d "${projectdir}" \
                    -m mulle-sde/c-developer \
                    "${projecttype}" \
   || fail "${projecttype} init failed"

   (
      cd "${projectdir}" || exit 1

      run_mulle_sde -s test init || fail "${projecttype} test init failed"

      (
         cd test || exit 1

         output="`run_mulle_sde -v test clean 2>&1`" || fail "${projecttype} test clean in test dir failed"
         expect_line "Cleaning target" "${output}"

         case "${projecttype}" in
            executable)
               output="`run_mulle_sde -v test run 2>&1`" || fail "${projecttype} test run in test dir failed:
${output}"
               expect_line "Run tests" "${output}"
            ;;
            library)
               run_mulle_sde -s test craft || fail "${projecttype} test craft in test dir failed"
            ;;
         esac
      ) || exit 1
   ) || exit 1
}


main()
{
   MULLE_SDE_FLAGS="$@"

   _options_mini_main "$@" && set -x

   local directory

   r_make_tmp_directory || exit 1
   directory="${RVAL}"
   directory="${directory:-/tmp/build}"

   run_case executable "${directory}/executable" || exit 1
   run_case library "${directory}/library" || exit 1

   log_info "----- ALL PASSED -----"

   cd ..
   chmod -R u+w "${directory}" 2>/dev/null
   rmdir_safer "${directory}"
}


init()
{
   MULLE_SDE="${MULLE_SDE:-${PWD}/../../mulle-sde}"
}


init "$@"
main "$@"
