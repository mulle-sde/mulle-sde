#! /bin/sh

[ "${TRACE}" = 'YES' ] && set -x && : "$0" "$@"

###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###
MULLE_BASHFUNCTIONS_LIBEXEC_DIR="`mulle-bashfunctions libexec-dir`" || exit 1
export MULLE_BASHFUNCTIONS_LIBEXEC_DIR
. "${MULLE_BASHFUNCTIONS_LIBEXEC_DIR}/mulle-boot.sh" || exit 1
. "${MULLE_BASHFUNCTIONS_LIBEXEC_DIR}/mulle-bashfunctions.sh" || exit 1
###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###   ###


run_mulle_sde()
{
   log_fluff "####################################" >&2
   log_fluff ${MULLE_SDE} ${MULLE_SDE_FLAGS} "$@"
   log_fluff "####################################" >&2

   (
      MULLE_EXECUTABLE="${MULLE_SDE}"
      MULLE_SDE_LIBEXEC_DIR="`${MULLE_SDE} libexec-dir`"

      . "${MULLE_SDE}" ${MULLE_SDE_FLAGS} "$@"
   )
}


main()
{
   MULLE_SDE_FLAGS="$@"

   _options_mini_main "$@" && set -x

   local directory

   r_make_tmp_directory || exit 1
   directory="${RVAL}"
   directory="${directory:-/tmp/build}"

   run_mulle_sde -s init \
                    -d "${directory}" \
                    -m mulle-sde/c-developer \
                    executable \
   || fail "init failed"

   (
      cd "${directory}" || exit 1

      run_mulle_sde -s test init || fail "test init failed"

      #
      # mulle-sde clean only removes the test project's own kitchen
      # (test/kitchen), not the per-suite kitchens (test/10-first/kitchen).
      # Every clean operation (explicit `test clean` and the clean+cmd
      # aliases going through auto_clean) must delegate to `mulle-test clean`,
      # which removes those, otherwise stale test build dirs survive and get
      # reused.
      #
      assert_nested_kitchen_removed "all"
      assert_nested_kitchen_removed
   ) || exit 1

   log_info "----- ALL PASSED -----"

   cd ..
   chmod -R u+w "${directory}" 2>/dev/null
   rmdir_safer "${directory}"
}


assert_nested_kitchen_removed()
{
   local args="${1:-}"

   local nested

   nested="${PWD}/test/10-first/kitchen"
   mkdir -p "${nested}" || fail "could not create nested kitchen \"${nested}\""

   run_mulle_sde -s test clean ${args} || fail "mulle-sde test clean ${args} failed"

   if [ -d "${nested}" ]
   then
      fail "mulle-sde test clean ${args} did not remove nested kitchen \"${nested}\""
   fi
}


init()
{
   MULLE_SDE="${MULLE_SDE:-${PWD}/../../mulle-sde}"
}


init "$@"
main "$@"
